{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-ME-RENDER-SERVICE.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api|assets|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
